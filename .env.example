# Copia este archivo a .env (cp .env.example .env). El .env nunca se sube a Git.

# =============================================================================
# 1. Demo (uv run demo-stack)
# =============================================================================
# La demo genera en cada arranque las claves, los tokens y la configuración de todos los
# servicios. De este archivo solo lee la clave del modelo y, si están, las variables AGENT_MODEL*
# y AGENT_HNP_REVIEWER_MODEL.

# Clave de la API de Anthropic, con saldo: el agente conversa y elige con Claude.
ANTHROPIC_API_KEY=
# Opcional: cualquier modelo de Claude. La evaluación usa claude-haiku-5-5 y claude-sonnet-5-5.
AGENT_MODEL=claude-haiku-5-5
# Opcional: esfuerzo de cada petición al modelo: low, medium, high, xhigh o max.
AGENT_MODEL_EFFORT=low

# =============================================================================
# 2. Arranque manual (cada servicio a mano; ver «Arranque manual» en el README)
# =============================================================================
# Los secretos llevan valores aleatorios de al menos 32 caracteres y nunca salen de este archivo.

# Comercio. HTTP solo se admite en loopback.
MERCHANT_BASE_URL=http://127.0.0.1:4120
# Sesión que emite el CLI del comercio (commerce_lab.db issue-session).
MERCHANT_BEARER_TOKEN=
# El mismo valor que en el comercio; solo verifica sus webhooks y nunca llega al modelo.
MERCHANT_WEBHOOK_SECRET=
# Tiempo máximo de cada petición al comercio, en segundos (hasta 30).
# MERCHANT_TIMEOUT_SECONDS=5

# Proveedor de pagos sandbox. El token identifica al agente ante el proveedor, no ante el comercio.
PAYMENT_PROVIDER_URL=http://127.0.0.1:4130
PAYMENT_AGENT_BEARER_TOKEN=

# Secreto propio del agente que liga la aprobación humana a los términos exactos de la compra.
AGENT_APPROVAL_SECRET=
# SQLite del agente; los checkpoints de LangGraph van al lado, en agent.graph.db.
AGENT_DATABASE_PATH=.local/agent.db
# El agente lee el feed que publica el comercio antes de cada turno.
AGENT_FEED_SOURCE=merchant
# Solo para probar con un feed fijo del repositorio:
# AGENT_FEED_SOURCE=file
# AGENT_FEED_PATH=tests/fixtures/feed

# Comprador. Con local, el backend usa AGENT_PRINCIPAL_ID; con jwt valida los JWT del servicio
# auth/, cuyo emisor es el origen de la UI (Vite reenvía /api/auth a ese servicio).
AGENT_PRINCIPAL_ID=local-human
AGENT_AUTH_MODE=local
# AGENT_AUTH_ISSUER=http://127.0.0.1:5173
AGENT_UI_ORIGIN=http://127.0.0.1:5173
# Instante fijo para episodios sandbox deterministas; solo en pruebas.
# AGENT_SANDBOX_CLOCK_AT=2026-09-10T14:05:00Z

# AP2 con la persona presente: mandatos y recibos firmados. Actívalo solo con las mismas claves
# de confianza en los tres servicios; exige AGENT_AUTH_MODE=jwt.
# AGENT_AP2_REQUIRED=true
# AGENT_AP2_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Gobernanza de la compra: off (por defecto, sin política), shadow (evalúa la política y registra
# su decisión sin bloquear) o enforce (la política decide antes de crear el checkout).
# AGENT_GOVERNANCE_MODE=off
# Qué sigue a un permiso en enforce: blocked (por defecto) se detiene sin crear el checkout;
# governed lo crea y sigue con la aprobación humana, que la política vuelve a revisar.
# AGENT_HP_FLOW=blocked
# Política que evalúan shadow y enforce.
# AGENT_D1_POLICY_SET_ID=b2-hp-v2
# AGENT_D1_POLICY_REVISION=1
# AGENT_D1_KEY_ID=local
# Dos claves distintas de 64 caracteres hexadecimales (openssl rand -hex 32): una para los
# seudónimos y otra para cifrar la evidencia.
# AGENT_D1_HMAC_KEY_HEX=
# AGENT_D1_AES_KEY_HEX=
# Comercios permitidos, separados por comas. Sin la variable, solo MERCHANT_BASE_URL.
# AGENT_D1_ALLOWED_MERCHANT_ORIGINS=http://127.0.0.1:4120
# En lugar de esa lista: un archivo de política publicado y su digest de confianza.
# AGENT_D1_POLICY_PATH=
# AGENT_D1_POLICY_DIGEST=
# Nombre del reloj comercial cuando se inyecta uno (solo pruebas y evaluación).
# AGENT_D1_COMMERCIAL_CLOCK_ID=

# Compra delegada (la persona autoriza antes y el agente compra después), apagada por defecto:
# sin el flag no existe ninguna de sus rutas ni tablas. Exige AGENT_AUTH_MODE=jwt, AP2, la clave
# del agente, los dos tokens, las claves AGENT_D1_* y AGENT_GOVERNANCE_MODE=off, o enforce con
# AGENT_HP_FLOW=governed.
# AGENT_HNP_ENABLED=false
# Clave EC P-256 que cierra los mandatos abiertos; distinta de AGENT_AP2_PRIVATE_KEY_PEM.
# AGENT_HNP_AGENT_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Tokens Bearer de /internal/hnp/*: al menos 32 caracteres cada uno, y distintos.
# AGENT_HNP_SERVICE_TOKEN=
# AGENT_HNP_OPERATOR_TOKEN=
# AGENT_HNP_MAX_VALIDITY_SECONDS=86400
# AGENT_HNP_PROPOSAL_TTL_SECONDS=600
# Quién elige la variante: deterministic (la mejor del ranking) o llm (el modelo, dentro de las
# opciones autorizadas; requiere ANTHROPIC_API_KEY).
# AGENT_HNP_SELECTOR=deterministic
# Un segundo modelo revisa esa elección contra el pedido y escala si no la confirma: off o llm
# (solo con AGENT_GOVERNANCE_MODE=enforce y ANTHROPIC_API_KEY).
# AGENT_HNP_REVIEWER=off

# Más ajustes del modelo; la demo también los lee.
AGENT_MODEL_TIMEOUT_SECONDS=30
# Resúmenes del razonamiento que POST /assistant muestra como partes «reasoning»; nunca vuelven
# al prompt.
AGENT_MODEL_REASONING_SUMMARY=false
# Modelo del revisor de la compra delegada, si no es AGENT_MODEL.
# AGENT_HNP_REVIEWER_MODEL=claude-sonnet-5-5
