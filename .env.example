# The merchant URL may use HTTP only for a loopback development address.
MERCHANT_BASE_URL=http://127.0.0.1:4120

# Issued locally by the merchant CLI. Never commit the real value.
MERCHANT_BEARER_TOKEN=

# Used later by the webhook verifier. Never expose it to the model.
MERCHANT_WEBHOOK_SECRET=

# Local agent authority. Use independent random values outside development.
AGENT_APPROVAL_SECRET=
# AP2 Human Present. Enable only after configuring the same trust set in all three services.
# AGENT_AP2_REQUIRED=true
# AGENT_AP2_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
PAYMENT_PROVIDER_URL=http://127.0.0.1:4130
PAYMENT_AGENT_BEARER_TOKEN=
AGENT_DATABASE_PATH=.local/agent.db
# Production/default: fetch the merchant-owned feed before each conversation turn.
AGENT_FEED_SOURCE=merchant
# Only for isolated experiments/tests with a pinned local ACP feed:
# AGENT_FEED_SOURCE=file
# AGENT_FEED_PATH=artifacts/feed/p0
AGENT_PRINCIPAL_ID=local-human
# Use jwt in any public deployment. The issuer is the public UI origin served through /api/auth.
AGENT_AUTH_MODE=local
# AGENT_AUTH_ISSUER=http://127.0.0.1:5173
AGENT_UI_ORIGIN=http://127.0.0.1:5173
# Optional fixed instant for deterministic sandbox episodes. Never set this in production.
# AGENT_SANDBOX_CLOCK_AT=2026-09-10T14:05:00Z

# Optional model that decides whether to respond, clarify, or prepare a purchase.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
# Optional Responses API reasoning summaries shown as "reasoning" parts by POST /assistant.
# Only models that support reasoning accept these settings; summaries never enter prompts.
OPENAI_REASONING_SUMMARY=false
# Optional reasoning effort for every model request: minimal, low, medium, or high.
# OPENAI_REASONING_EFFORT=low
