# The merchant URL may use HTTP only for a loopback development address.
MERCHANT_BASE_URL=http://127.0.0.1:4120

# Issued locally by the merchant CLI. Never commit the real value.
MERCHANT_BEARER_TOKEN=

# Used later by the webhook verifier. Never expose it to the model.
MERCHANT_WEBHOOK_SECRET=

# Local agent authority. Use independent random values outside development.
AGENT_APPROVAL_SECRET=
# AP2 Human Present. Enable only after configuring the same trust set in all three services.
# AGENT_AP2_REQUIRED=true
# AGENT_AP2_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# AP2 Human Not Present: the Agent Key closes the open mandates (cnf). EC P-256 private key,
# distinct from AGENT_AP2_PRIVATE_KEY_PEM. Read only when HNP is enabled.
# AGENT_HNP_AGENT_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Human Not Present delegations (docs/design/hnp-governed.md §6). Off by default: no route or
# table exists. Enabling it requires AGENT_AUTH_MODE=jwt, AP2 Human Present, the agent key, the
# two tokens, AGENT_D1_KEY_ID/AGENT_D1_HMAC_KEY_HEX/AGENT_D1_AES_KEY_HEX, and
# AGENT_GOVERNANCE_MODE=off, or enforce with AGENT_HP_FLOW=governed.
# AGENT_HNP_ENABLED=false
# Bearer tokens of /internal/hnp/*: at least 32 characters each, and distinct.
# AGENT_HNP_SERVICE_TOKEN=
# AGENT_HNP_OPERATOR_TOKEN=
# AGENT_HNP_MAX_VALIDITY_SECONDS=86400
# AGENT_HNP_PROPOSAL_TTL_SECONDS=600
# How the executor picks a variant of the grant's shortlist: deterministic (the best ranked) or
# llm (the model, bounded to the shortlist; requires OPENAI_API_KEY and OPENAI_MODEL).
# AGENT_HNP_SELECTOR=deterministic
PAYMENT_PROVIDER_URL=http://127.0.0.1:4130
PAYMENT_AGENT_BEARER_TOKEN=
AGENT_DATABASE_PATH=.local/agent.db
# Production/default: fetch the merchant-owned feed before each conversation turn.
AGENT_FEED_SOURCE=merchant
# Only for isolated experiments/tests with a pinned local ACP feed:
# AGENT_FEED_SOURCE=file
# AGENT_FEED_PATH=artifacts/feed/p0
AGENT_PRINCIPAL_ID=local-human
# Use jwt in any public deployment. The issuer is the public UI origin served through /api/auth.
AGENT_AUTH_MODE=local
# AGENT_AUTH_ISSUER=http://127.0.0.1:5173
AGENT_UI_ORIGIN=http://127.0.0.1:5173
# Optional fixed instant for deterministic sandbox episodes. Never set this in production.
# AGENT_SANDBOX_CLOCK_AT=2026-09-10T14:05:00Z

# Optional model that decides whether to respond, clarify, or prepare a purchase.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
# Optional Responses API reasoning summaries shown as "reasoning" parts by POST /assistant.
# Only models that support reasoning accept these settings; summaries never enter prompts.
OPENAI_REASONING_SUMMARY=false
# Optional reasoning effort for every model request: minimal, low, medium, or high.
# OPENAI_REASONING_EFFORT=low

# EC-HNP-02: offline experiment with an LLM validator over a fictitious sink. Never an
# operation: no checkout, payment or merchant is reachable from either arm.
# Dry run (no provider):  uv run hnp-matrix --dry-run --env-file .env.example
# Provider calls need HNP_LIVE=1, OPENAI_API_KEY, verified prices and a budget that covers the
# upper-bound estimate the script prints first. Model, prices and budget are open decisions.
HNP_LIVE=0
HNP_VALIDATOR_MODEL=gpt-5-mini
# Phase 1 keeps the scripted buyer payloads; this model is used from Phase 2 on.
HNP_BUYER_MODEL=gpt-5-mini
# none = provider default; reasoning models reject an explicit temperature.
HNP_TEMPERATURE=none
# minimal, low, medium, high, or none for models without reasoning.
HNP_REASONING_EFFORT=low
# The Responses API has no seed: this fixes the episode order and the dry-run answers.
HNP_SEED=20261022
# Deadline per validator call: the coordinator stops waiting and blocks (timeout result).
HNP_TIMEOUT_SECONDS=30
# Caps reasoning plus answer tokens; too low makes truncated (invalid) answers.
HNP_MAX_OUTPUT_TOKENS=2048
HNP_REPETITIONS=5
# USD per million tokens. Placeholders from gpt-5-mini's launch price list (Aug 2025):
# verify the current price for the chosen model before any live run.
HNP_VALIDATOR_INPUT_USD_PER_MTOK=0.25
HNP_VALIDATOR_OUTPUT_USD_PER_MTOK=2.00
HNP_BUYER_INPUT_USD_PER_MTOK=0.25
HNP_BUYER_OUTPUT_USD_PER_MTOK=2.00
# 0 = no approved budget: live runs refuse to start.
HNP_MAX_COST_USD=0
HNP_VALIDATOR_PROMPT=validator-v1
HNP_BUYER_PROMPT=buyer-v1
HNP_CASES_PATH=evaluation/data/hnp/cases.json
HNP_ORACLE_PATH=evaluation/data/hnp/oracle.json
# Must stay under .local/ (ignored by Git).
HNP_OUTPUT_DIR=.local/hnp02
