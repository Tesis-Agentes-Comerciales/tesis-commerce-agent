 x="1434" y="558"/></Array></mxGeometry></mxCell><mxCell id="48" value="payment_declined&lt;br/&gt;o out_of_stock" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#9f3341;" vertex="1" parent="1"><mxGeometry x="1285" y="654" width="302" height="66" as="geometry"/></mxCell><mxCell id="49" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeWidth=3;strokeColor=#335b84;strokeColor=#7756a8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2018" y="558" as="sourcePoint"/><mxPoint x="2240" y="754" as="targetPoint"/><Array as="points"><mxPoint x="2240" y="558"/></Array></mxGeometry></mxCell><mxCell id="50" value="timeout / 5xx /&lt;br/&gt;idempotency_in_flight" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#64478f;" vertex="1" parent="1"><mxGeometry x="2090" y="625" width="130" height="72" as="geometry"/></mxCell><mxCell id="51" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeWidth=3;strokeColor=#335b84;strokeColor=#7756a8;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2073" y="754" as="sourcePoint"/><mxPoint x="2018" y="604" as="targetPoint"/><Array as="points"><mxPoint x="2045" y="700"/></Array></mxGeometry></mxCell><mxCell id="52" value="Reintento si sigue abierto" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#64478f;" vertex="1" parent="1"><mxGeometry x="1865" y="665" width="160" height="64" as="geometry"/></mxCell><mxCell id="53" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeWidth=3;strokeColor=#335b84;strokeColor=#7756a8;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="858" as="sourcePoint"/><mxPoint x="2018" y="1048" as="targetPoint"/><Array as="points"><mxPoint x="2240" y="1048"/></Array></mxGeometry></mxCell><mxCell id="54" value="Reconciliar si completed" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#64478f;" vertex="1" parent="1"><mxGeometry x="2030" y="925" width="195" height="65" as="geometry"/></mxCell><mxCell id="55" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeWidth=3;strokeColor=#335b84;strokeColor=#9d710f;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1678" y="532" as="sourcePoint"/><mxPoint x="1678" y="330" as="targetPoint"/><Array as="points"><mxPoint x="1598" y="532"/><mxPoint x="1598" y="330"/></Array></mxGeometry></mxCell><mxCell id="56" value="4xx determinista no terminal&lt;br/&gt;→ vuelve a approved" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#8b6410;" vertex="1" parent="1"><mxGeometry x="1260" y="405" width="390" height="68" as="geometry"/></mxCell><mxCell id="57" value="Desde uncertain: GET al ecommerce. Si ya completó, reconciliar Order; si sigue abierto y la aprobación es válida, reintentar con la misma clave idempotente. Cancelar solo desde awaiting_confirmation." style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=#cad9e7;strokeWidth=1.7;fillColor=#f8fbff;fontColor=#465b70;fontSize=19;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1282" y="1156" width="1160" height="105" as="geometry"/></mxCell><mxCell id="58" value="Límite actual: una caída del proceso puede dejar selected, checkout_prepared o completing pendientes sin recuperación automática; en completing, /complete responde completion_in_progress." style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;al