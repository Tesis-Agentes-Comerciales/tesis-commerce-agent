        </mxCell>
        <mxCell id="104" value="Cada cuadro cuenta una repetición: lleno, cumple el oráculo; vacío, no cumple. Gris: B0' · azul: B2. Fuente: evaluation/results/b0prime-b2-20261020T201055Z.summary.json (informe: b2-pilot-v1-report.md)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
