        <mxCell id="99" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:16px;color:#686868&quot;&gt;Cumple el oráculo&lt;/div&gt;&lt;div style=&quot;font-size:26px;color:#333333;margin-top:4px&quot;&gt;&lt;b&gt;16/25 → 25/25&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#555555;margin-top:4px&quot;&gt;B0' → B2&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336C96;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
