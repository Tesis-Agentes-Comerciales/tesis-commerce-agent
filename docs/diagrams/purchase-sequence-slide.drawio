        <mxCell id="32" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:21px;color:#333333;line-height:1.15&quot;&gt;&lt;b&gt;S02 · presupuesto incompatible&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#686868;margin-top:3px&quot;&gt;[B0 + B2 · hecho]&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84E4E;strokeWidth=2.5;dashed=0;fontFamily=Arial;fontColor=#333333;align=center;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="248" y="540" width="808" height="232" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;b&gt;Paso 2 · elección fuera de la lista corta&lt;/b&gt;&lt;br&gt;La recuperación la explica sin crear checkout; en B0' daba 502." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontColor=#333333;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="264" y="606" width="380" height="92" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;b&gt;Paso 5 · total sobre el presupuesto&lt;/b&gt;&lt;br&gt;El presupuesto autoritativo (B0) cancela el checkout y la recuperación (B2) lo explica." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontColor=#333333;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="606" width="380" height="92" as="geometry" />
        </mxCell>
        <mxCell id="35" value="Piloto · recuperación: 5xx 4/5 → 0/5 (B0': 502 intent_model_error en 4). En B2, 1 elección fuera de la lista y, por presupuesto, 3/5 checkouts creados y cancelados." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#686868;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="264" y="704" width="776" height="56" as="geometry" />
        </mxCell>
        <mxCell id="36" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A84E4E;strokeWidth=2.4;dashed=0;dashPattern=7 6;endArrow=block;endFill=1;endSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1168" y="442" as="sourcePoint" />
            <mxPoint x="1168" y="538" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="37" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:21px;color:#333333;line-height:1.15&quot;&gt;&lt;b&gt;S04 · la oferta cambió&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#686868;margin-top:3px&quot;&gt;[B2 · hecho]&lt;/div&gt;&lt;div style=&quot;font-size:18px;color:#555555;margin-top:6px;line-height:1.25&quot;&gt;409 checkout_terms_changed: sin firma, pago ni orden (frescura de la oferta)&lt;div style=&quot;color:#686868;margin-top:8px&quot;&gt;Piloto: aprobaciones obsoletas 5/5 → 0/5&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84E4E;strokeWidth=2.5;dashed=0;fontFamily=Arial;fontColor=#333333;align=center;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="540" width="392" height="232" as="geometry" />
        </mxCell>
        <mxCell id="38" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:21px;color:#333333;line-height:1.15&quot;&gt;&lt;b&gt;Consentimiento e identidad (D2-HP)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#686868;margin-top:3px&quot;&gt;[B2 · planificado]&lt;/div&gt;&lt;div style=&quot;font-size:18px;color:#555555;margin-top:6px;line-height:1.25&quot;&gt;Al aprobar, antes de firmar. &lt;span style=&quot;white-space:nowrap&quot;&gt;POL-03..06&lt;/span&gt; definidas en policy-v1, sin evaluador&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336C96;strokeWidth=2.5;dashed=1;dashPattern=10 6;fontFamily=Arial;fontColor=#333333;align=center;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1496" y="540" width="384" height="232" as="geometry" />
        </mxCell>
        <mxCell id="39" value="&lt;b&gt;S04 y S02 no son denegaciones del PDP.&lt;/b&gt; D1 permitió cada compra que evaluó (5/5 en S04 y 3/3 en S02); las detienen controles de aplicación: la frescura de la oferta, el presupuesto autoritativo y la recuperación gobernada." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=20;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="812" width="1820" height="64" as="geometry" />
        </mxCell>
        <mxCell id="40" value="Evidencia: cada decisión de D1 queda en governance_evidence; la frescura y la recuperación, en hp_evidence; la traza de la compra en el chat muestra las tres. Un deny de D1 detiene la compra antes de cualquier POST, como el de &lt;span style=&quot;white-space:nowrap&quot;&gt;POL-02&lt;/span&gt; en la prueba live de #48 y en el modo pol02-deny de la demo." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=19;fontColor=#555555;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="886" width="1820" height="60" as="geometry" />
        </mxCell>
        <mxCell id="41" value="Estado" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
