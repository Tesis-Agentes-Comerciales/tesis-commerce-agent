        <mxCell id="44" value="S01-S05 × 5 repeticiones × 2 condiciones = 50 corridas, pareadas por (escenario, repetición). Orden ilustrativo: la condición que va primero alterna." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="940" width="1360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="45" value="Evaluado como paquete, reportado por mecanismo: S02 → recuperación; S04 → frescura; nada se atribuye al PDP si lo produjo otro control." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="990" width="1360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="46" value="Plan B si el despacho en vivo falla: B2-lite (D1 en shadow, frescura y recuperación activas), declarado aparte y nunca reportado como enforce." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
