;color:#687b91&quot;&gt;POST /purchases/{run_id}/approval&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="610" y="974" width="420" height="44" as="geometry"/></mxCell><mxCell id="44" value="Agente: GET checkout vigente → compara fingerprint/HMAC → guarda aprobación en SQLite." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=#e8bd7a;strokeWidth=1.6;fillColor=#fffdf7;fontColor=#69552f;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="1051" width="1020" height="50" as="geometry"/></mxCell><mxCell id="45" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="1244" as="sourcePoint"/><mxPoint x="1045" y="1244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="46" value="&lt;b&gt;Solicitar completion&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /purchases/{run_id}/complete&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="610" y="1195" width="420" height="44" as="geometry"/></mxCell><mxCell id="47" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="1318" as="sourcePoint"/><mxPoint x="1580" y="1318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="&lt;b&gt;Revalidar checkout&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;GET /checkout_sessions/{id} · aprobación y presupuesto&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=no