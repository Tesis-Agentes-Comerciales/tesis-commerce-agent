confirma Order. No se simula éxito." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#586b7d;" vertex="1" parent="1"><mxGeometry x="1566" y="2011" width="680" height="72" as="geometry"/></mxCell><mxCell id="73" value="El webhook order_create se publica después desde el outbox del ecommerce; no forma parte de la confirmación síncrona mostrada aquí." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#65778c;" vertex="1" parent="1"><mxGeometry x="40" y="2120" width="2220" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
