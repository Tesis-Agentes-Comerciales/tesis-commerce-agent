        <mxCell id="37" value="La aprobación es del mismo D1, intento y términos&lt;div style=&quot;color:#686868;margin-top:1px&quot;&gt;Hoy, en parte: continuación gobernada&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
