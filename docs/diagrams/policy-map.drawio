        <mxCell id="48" value="[B2 · futuro]" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
