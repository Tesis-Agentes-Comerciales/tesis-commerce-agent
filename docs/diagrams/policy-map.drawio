        <mxCell id="43" value="&lt;b&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;POL-07 a POL-10&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Delegación HNP" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
