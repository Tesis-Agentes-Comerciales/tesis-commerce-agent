        <mxCell id="45" value="&lt;b&gt;D2-HNP y D3-HNP · PDP&lt;/b&gt;&lt;br&gt;sin humano presente" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#686868;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
