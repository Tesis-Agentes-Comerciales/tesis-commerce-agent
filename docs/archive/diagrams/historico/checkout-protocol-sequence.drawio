&gt;&lt;font style=&quot;font-size:16px&quot;&gt;ACP REST &#xB7; PostgreSQL&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=#ae6205;strokeWidth=2.4;fillColor=#fffbf5;fontColor=#ae6205;fontSize=22;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1452" y="145" width="256" height="74" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Proveedor&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:16px&quot;&gt;pago de prueba&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=#b52b3d;strokeWidth=2.4;fillColor=#fff8f9;fontColor=#b52b3d;fontSize=22;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2022" y="145" width="256" height="74" as="geometry"/></mxCell><mxCell id="14" value="" style="rounded=1;arcSize=2;strokeColor=#dce5ef;strokeWidth=1.4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="28" y="255" width="2254" height="421" as="geometry"/></mxCell><mxCell id="15" value="" style="rounded=1;arcSize=2;strokeColor=none;fillColor=#eef5ff;" vertex="1" parent="1"><mxGeometry x="28" y="255" width="2254" height="52" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;01 &#xB7; SESI&#xD3;N ACP AUTORITATIVA&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#1d5ca8;" vertex="1" parent="1"><mxGeometry x="48" y="262" width="650" height="38" as="geometry"/></mxCell><mxCell id="17" value="El comercio define precio e inventario; el presupuesto se verifica antes de pedir aprobaci&#xF3;n." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#50647a;" vertex="1" parent="1"><mxGeometry x="695" y="263" width="1550" height="35" as="geometry"/></mxCell><mxCell id="18" value="" style="rounded=1;arcSize=2;strokeColor=#dce5ef;strokeWidth=1.4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="28" y="697" width="2254" height="421" as="geometry"/></mxCell><mxCell id="19" value="" style="rounded=1;arcSize=2;strokeColor=none;fillColor=#fff5e8;" vertex="1" parent="1"><mxGeometry x="28" y="697" width="2254" height="52" as="geometry"/></mxCell><mxCell id="20" value="&lt;b&gt;02 &#xB7; APROBACI&#xD3;N HUMANA&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#9c5a04;" vertex="1" parent="1"><mxGeometry x="48" y="704" width="650" height="38" as="geometry"/></mxCell><mxCell id="21" value="La interfaz presenta t&#xE9;rminos exactos; el agente registra una aprobaci&#xF3;n vinculada a ellos." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#50647a;" vertex="1" parent="1"><mxGeometry x="695" y="705" width="1550" height="35" as="geometry"/></mxCell><mxCell id="22" value="" style="rounded=1;arcSize=2;strokeColor=#dce5ef;strokeWidth=1.4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="28" y="1139" width="2254" height="745" as="geometry"/></mxCell><mxCell id="23" value="" style="rounded=1;arcSize=2;strokeColor=none;fillColor=#fff0f2;" vertex="1" parent="1"><mxGeometry x="28" y="1139" width="2254" height="52" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;03 &#xB7; DELEGACI&#xD3;N Y FINALIZACI&#xD3;N&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#a42a3b;" vertex="1" parent="1"><mxGeometry x="48" y="1146" width="650" height="38" as="geometry"/></mxCell><mxCell id="25" value="El agente solicita un token; el comercio confirma el pago y crea el pedido." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#50647a;" vertex="1" parent="1"><mxGeometry x="695" y="1147" width="1550" height="35" as="geometry"/></mxCell><mxCell id="26" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="360" as="sourcePoint"/><mxPoint x="1580" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="&lt;b&gt;Crear sesi&#xF3;n&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /checkout_sessions &#xB7; variant_id + idempotency_key&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1060" y="311" width="505" height="44" as="geometry"/></mxCell><mxCell id="28" style="edgeStyle=none;html=1;strokeColor=#718399;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="435" as="sourcePoint"/><mxPoint x="1045" y="435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="&lt;b&gt;Sesi&#xF3;n con precio e inventario&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;201 CheckoutSession &#xB7; total_minor&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1060" y="386" width="505" height="44" as="geometry"/></mxCell><mxCell id="30" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="510" as="sourcePoint"/><mxPoint x="1580" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="&lt;b&gt;Aplicar comprador y entrega&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;c