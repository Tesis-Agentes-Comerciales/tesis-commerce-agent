<mxfile host="app.diagrams.net" modified="2026-09-23T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="checkout-protocol" name="Sesi&#xF3;n ACP y pago"><mxGraphModel dx="2300" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2310" pageHeight="2190" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Secuencia t&#xE9;cnica: sesi&#xF3;n ACP y pago delegado&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=38;fontColor=#15243a;" vertex="1" parent="1"><mxGeometry x="36" y="28" width="2100" height="59" as="geometry"/></mxCell><mxCell id="3" value="Empieza despu&#xE9;s de que el agente eligi&#xF3; una variante. Aqu&#xED; se muestran contratos, validaciones y due&#xF1;os de cada paso; no el di&#xE1;logo de compra." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#61748a;" vertex="1" parent="1"><mxGeometry x="38" y="92" width="2240" height="35" as="geometry"/></mxCell><mxCell id="4" style="edgeStyle=none;html=1;strokeColor=#b6c5d7;strokeWidth=1.5;dashed=1;dashPattern=7 6;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="220" as="sourcePoint"/><mxPoint x="165" y="1887" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5" style="edgeStyle=none;html=1;strokeColor=#b6c5d7;strokeWidth=1.5;dashed=1;dashPattern=7 6;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="220" as="sourcePoint"/><mxPoint x="595" y="1887" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6" style="edgeStyle=none;html=1;strokeColor=#b6c5d7;strokeWidth=1.5;dashed=1;dashPattern=7 6;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="220" as="sourcePoi