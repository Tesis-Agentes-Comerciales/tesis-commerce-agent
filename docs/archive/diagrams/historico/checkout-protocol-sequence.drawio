urcePoint"/><mxPoint x="595" y="801" as="targetPoint"/></mxGeometry></mxCell><mxCell id="37" value="&lt;b&gt;Presentar t&#xE9;rminos&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;SSE request_approval + fingerprint&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="610" y="752" width="420" height="44" as="geometry"/></mxCell><mxCell id="38" style="edgeStyle=none;html=1;strokeColor=#718399;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="875" as="sourcePoint"/><mxPoint x="165" y="875" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="&lt;b&gt;Mostrar total y bot&#xF3;n &#xAB;Aprobar&#xBB;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="180" y="826" width="400" height="44" as="geometry"/></mxCell><mxCell id="40" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="949" as="sourcePoint"/><mxPoint x="595" y="949" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" value="&lt;b&gt;Aprobar t&#xE9;rminos mostrados&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="180" y="900" width="400" height="44" as="geometry"/></mxCell><mxCell id="42" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="1023" as="sourcePoint"/><mxPoint x="1045" y="1023" as="targetPoint"/></mxGeometry></mxCell><mxCell id="43" value="&lt;b&gt;Enviar aprobaci&#xF3;n&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /purchases/{run_id}/approval&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="610" y="974" width="420" height="44" as="geometry"/></mxCell><mxCell id="44" value="Agente: consulta la sesi&#xF3;n vigente &#x2192; compara la huella/HMAC &#x2192; guarda aprobaci&#xF3;n en SQLite." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=#e8bd7a;strokeWidth=1.6;fillColor=#fffdf7;fontColor=#69552f;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="1051" width="1020" height="50" as="geometry"/></mxCell><mxCell id="45" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="1244" as="sourcePoint"/><mxPoint x="1045" y="1244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="46" value="&lt;b&gt;Solicitar finalizaci&#xF3;n&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /purchases/{run_id}/complete&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="610" y="1195" width="420" height="44" as="geometry"/></mxCell><mxCell id="47" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="1318" as="sourcePoint"/><mxPoint x="1580" y="1318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="&lt;b&gt;Revalidar sesi&#xF3;n&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;GET /checkout_sessions/{id} &#xB7; aprobaci&#xF3;n y presupuesto&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1060" y="1269" width="505" height="44" as="geometry"/></mxCell><mxCell id="49" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="1392" as="sourcePoint"/><mxPoint x="2150" y="1392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="50" value="&lt;b&gt;Delegar instrumento&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /agentic_commerce/delegate_payment &#xB7; allowance&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1252.5" y="1343" width="690" height="44" as="geometry"/></mxCell><mxCell id="51" style="edgeStyle=none;html=1;strokeColor=#718399;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2150" y="1466" as="sourcePoint"/><mxPoint x="1045" y="1466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="52" value="&lt;b&gt;Token opaco y acotado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;vt_* &#xB7; sesi&#xF3;n + moneda + importe&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1252.5" y="1417" width="690" height="44" as="geometry"/></mxCell><mxCell id="53" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="1540" as="sourcePoint"/><mxPoint x="1580" y="1540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="54" value="&lt;b&gt;Completar compra&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /checkout_sessions/{id}/complete &#xB7; vt_*&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1060" y="1491" width="505" height="44" as="geometry"/></mxCell><mxCell id="55" style="edgeStyle=none;html=1;strokeColor=#32445b;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1614" as="sourcePoint"/><mxPoint x="2150" y="1614" as="targetPoint"/></mxGeometry></mxCell><mxCell id="56" value="&lt;b&gt;Confirmar cobro&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;POST /payments/confirm &#xB7; token + total&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1595" y="1565" width="540" height="44" as="geometry"/></mxCell><mxCell id="57" style="edgeStyle=none;html=1;strokeColor=#718399;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2150" y="1688" as="sourcePoint"/><mxPoint x="1580" y="1688" as="targetPoint"/></mxGeometry></mxCell><mxCell id="58" value="&lt;b&gt;Resultado del proveedor&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;approved&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1595" y="1639" width="540" height="44" as="geometry"/></mxCell><mxCell id="59" style="edgeStyle=none;html=1;strokeColor=#718399;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1762" as="sourcePoint"/><mxPoint x="1045" y="1762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="60" value="&lt;b&gt;Compra completada y pedido&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;Comercio descuenta inventario y guarda el pedido&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="1060" y="1713" width="505" height="44" as="geometry"/></mxCell><mxCell id="61" style="edgeStyle=none;html=1;strokeColor=#718399;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=block;endFill=1;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="1836" as="sourcePoint"/><mxPoint x="595" y="1836" as="targetPoint"/></mxGeometry></mxCell><mxCell id="62" value="&lt;b&gt;Pedido confirmado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px;color:#687b91&quot;&gt;order_id &#xB7; respuesta en la interfaz&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#26364b;" vertex="1" parent="1"><mxGeometry x="610" y="1787" width="420" height="44" as="geometry"/></mxCell><mxCell id="63" value="&lt;b&gt;SI NO SE CUMPLEN LAS CONDICIONES&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#40546b;" vertex="1" parent="1"><mxGeometry x="37" y="1915" width="750" height="39" as="geometry"/></mxCell><mxCell id="64" value="" style="rounded=1;arcSize=8;strokeColor=#cfdbe8;strokeWidth=1.5;fillColor=#f9fbfe;" vertex="1" parent="1"><mxGeometry x="36" y="1962" width="724" height="134" as="geometry"/></mxCell><mxCell id="65" value="&lt;b&gt;Presupuesto excedido&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#304860;" vertex="1" parent="1"><mxGeometry x="56" y="1974" width="680" height="30" as="geometry"/></mxCell><mxCell id="66" value="Agente cancela la sesi&#xF3;n. No presenta aprobaci&#xF3;n ni solicita token." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#586b7d;" vertex="1" parent="1"><mxGeometry x="56" y="2011" width="680" height="72" as="geometry"/></mxCell><mxCell id="67" value="" style="rounded=1;arcSize=8;strokeColor=#cfdbe8;strokeWidth=1.5;fillColor=#f9fbfe;" vertex="1" parent="1"><mxGeometry x="791" y="1962" width="724" height="134" as="geometry"/></mxCell><mxCell id="68" value="&lt;b&gt;T&#xE9;rminos cambiaron&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#304860;" vertex="1" parent="1"><mxGeometry x="811" y="1974" width="680" height="30" as="geometry"/></mxCell><mxCell id="69" value="La huella no coincide: invalida la aprobaci&#xF3;n y detiene la finalizaci&#xF3;n." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#586b7d;" vertex="1" parent="1"><mxGeometry x="811" y="2011" width="680" height="72" as="geometry"/></mxCell><mxCell id="70" value="" style="rounded=1;arcSize=8;strokeColor=#cfdbe8;strokeWidth=1.5;fillColor=#f9fbfe;" vertex="1" parent="1"><mxGeometry x="1546" y="1962" width="724" height="134" as="geometry"/></mxCell><mxCell id="71" value="&lt;b&gt;Pago rechazado / sin inventario&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#304860;" vertex="1" parent="1"><mxGeometry x="1566" y="1974" width="680" height="30" as="geometry"/></mxCell><mxCell id="72" value="El comercio devuelve un error; no confirma el pedido. No se simula &#xE9;xito." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#586b7d;" vertex="1" parent="1"><mxGeometry x="1566" y="2011" width="680" height="72" as="geometry"/></mxCell><mxCell id="73" value="El webhook order_create se publica despu&#xE9;s desde el buz&#xF3;n de salida del comercio; no forma parte de la confirmaci&#xF3;n s&#xED;ncrona mostrada aqu&#xED;." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#65778c;" vertex="1" parent="1"><mxGeometry x="40" y="2120" width="2220" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
