# SPA: cualquier ruta desconocida cae en index.html; los assets llevan hash y se cachean.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"

	handle /api/auth/* {
		reverse_proxy {$AUTH_UPSTREAM:127.0.0.1:4210} {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
