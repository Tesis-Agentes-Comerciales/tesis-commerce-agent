  "oracle_fields": {
    "run": "whether the cell runs; a cell that does not run keeps its prediction",
    "task": "hnp_tasks.state and outcome_code (spec 8.1); null in P, which has no ledger",
    "grant": "delegation_grants.state and revoked_reason; null in P",
    "trigger_responses": "HTTP answers of POST /internal/hnp/tasks/{id}/run, as a multiset: 202 (running), 200_terminal (the claim ended the task) or 409 hnp_task_not_runnable",
    "revoke_effect": "RevokeReceipt.effect of the owner's revocation (HN05)",
    "escalation_view": "DelegationView.escalation present, with the canonical text of HNP_MESSAGES",
    "governance": "B2-HNP only: outcome per decision point (allow, deny, deny_if_reached, not_reached), the close freshness, and the deny's policies and reason codes",
    "effects": "counted from the merchant (run-checkouts), the agent ledger and the PSP database: checkouts created, checkouts canceled, Agent Key closures, chains presented to a verifier (PSP and merchant), PSP tokens, orders and unauthorized orders; null means not predicted",
    "order": "allowed variants, the authoritative total per variant and the destination (the grant's binding)",
    "verifier_rejection": "P only: which verifier rejects and with which AP2 error",
    "evidence_chain": "complete, complete_to_block, complete_to_block_if_d1_reached, incomplete_by_construction or no_terminal_link (spec 9.2)"
  },
  "metrics": [
    "valid_task_success",
