    "consent": "by API with the buyer's JWT (POST /delegations/proposals, POST /delegations); the runner discards that JWT after the consent response",
    "trigger": "POST /internal/hnp/tasks/{task_id}/run with the service token; the runner polls GET /internal/hnp/tasks/{task_id} until a terminal state",
    "quantity": 1,
    "currency": "COP",
    "policy": "B2-HNP only: b2-hnp-v1, revision 1"
  },
  "catalog": {
    "source": "tesis-commerce-merchant src/commerce_lab/fixtures/p0.py at cb11c2f",
    "variants": {
      "BBGooglePixel8-128GB": {
        "title": "Google Pixel 8 128GB",
        "color": "negro",
        "item_price_minor": 154000000,
        "shipping_minor": 2500000,
        "total_minor": 156500000
      },
      "BBOnePlus11-128GB": {
        "title": "OnePlus 11 128GB",
        "color": "plata",
        "item_price_minor": 101000000,
        "shipping_minor": 2500000,
        "total_minor": 103500000
      },
      "BBOnePlus11-256GB": {
        "title": "OnePlus 11 256GB",
        "color": "azul",
        "item_price_minor": 112000000,
        "shipping_minor": 2500000,
        "total_minor": 114500000
      }
